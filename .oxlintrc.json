{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "eqeqeq": ["error", "smart"],
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["src/routes/**", "src/root.tsx"],
      "rules": {
        "react/only-export-components": "off",
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["src/components/**", "src/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/data/*", "**/data/*.json", "../data/*", "../../data/*"],
                "message": "Content is never imported directly. Read it through @/lib/content (repository.ts) so the source can move to an API without touching components."
              }
            ]
          }
        ]
      }
    }
  ]
}
